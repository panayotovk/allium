  "header": {
    "fixture_name": "TradingRisk",
    "source_package": "app/"
  },
  "integrations": [
    {
      "name": "clearing_house",
      "operations": [
        {
          "name": "post_margin_call",
          "params": [
            {
              "name": "amount_pence",
              "type_hint": "Integer"
            },
            {
              "name": "margin_call_id",
              "type_hint": "String"
            },
            {
              "name": "trader_id",
              "type_hint": "String"
            }
          ],
          "preconditions": [
            "amount_pence <= 1_000_000_000_00",
            "amount_pence > 0"
          ],
          "raises": [
            "ClearingHouseError"
          ],
          "return_type": "MarginPosting"
        },
        {
          "name": "request_collateral_release",
          "params": [
            {
              "name": "amount_pence",
              "type_hint": "Integer"
            },
            {
              "name": "trader_id",
              "type_hint": "String"
            }
          ],
          "preconditions": [
            "amount_pence > 0"
          ],
          "raises": [
            "ClearingHouseError"
          ],
          "return_type": "CollateralReleaseRequest"
        }
      ],
      "purpose": "Post margin and request collateral release with the upstream clearing house."
    },
    {
      "name": "market_data",
      "operations": [
        {
          "name": "snapshot_price",
          "params": [
            {
              "name": "instrument_symbol",
              "type_hint": "String"
            },
            {
              "name": "venue",
              "type_hint": "String"
            }
          ],
          "preconditions": [
            "instrument_symbol != null",
            "venue != null"
          ],
          "raises": [
            "MarketDataError"
          ],
          "return_type": "PriceSnapshot"
        },
        {
          "name": "subscribe_to_ticks",
          "params": [
            {
              "name": "delivery_endpoint",
              "type_hint": "String"
            },
            {
              "name": "instrument_symbol",
              "type_hint": "String"
            },
            {
              "name": "venue",
              "type_hint": "String"
            }
          ],
          "preconditions": [
            "instrument_symbol != null",
            "venue != null"
          ],
          "raises": [
            "MarketDataError"
          ],
          "return_type": "SubscriptionResponse"
        }
      ],
      "purpose": "Subscribe to tick feeds and pull synchronous price snapshots from the vendor."
    },
    {
      "name": "regulator_reporting",
      "operations": [
        {
          "name": "submit_position_report",
          "params": [
            {
              "name": "desk_id",
              "type_hint": "String"
            },
            {
              "name": "entries",
              "type_hint": "List<PositionReportEntry>"
            },
            {
              "name": "report_date",
              "type_hint": "Timestamp"
            }
          ],
          "preconditions": [
            "desk_id != null",
            "entries.count > 0"
          ],
          "raises": [
            "RegulatorReportingError"
          ],
          "return_type": "PositionReportSubmission"
        }
      ],
      "purpose": "Submit the desk's daily position report to the regulator's intake API."
    }
  ],
  "invariants": [
    {
      "enforced_by": [
        "reject_order"
      ],
      "expression": "status = rejected implies rejection_reason != null",
      "name": "RejectedOrdersHaveReason",
      "scope": "Order"
    }
  ],
  "routes": [
    {
      "handler": "desk_exposure_route",
      "method": "GET",
      "module": "app/routes.py",
      "path": "/desks/<desk_id>/exposure"
    },
    {
      "handler": "get_margin_call_route",
      "method": "GET",
      "module": "app/routes.py",
      "path": "/margin-calls/<margin_call_id>"
    },
    {
      "handler": "clear_margin_route",
      "method": "POST",
      "module": "app/routes.py",
      "path": "/margin-calls/<margin_call_id>/clear"
    },
    {
      "handler": "post_margin_route",
      "method": "POST",
      "module": "app/routes.py",
      "path": "/margin-calls/<margin_call_id>/post"
    },
    {
      "handler": "submit_order_route",
      "method": "POST",
      "module": "app/routes.py",
      "path": "/orders"
    },
    {
      "handler": "get_order_route",
      "method": "GET",
      "module": "app/routes.py",
      "path": "/orders/<order_id>"
    },
    {
      "handler": "cancel_order_route",
      "method": "POST",
      "module": "app/routes.py",
      "path": "/orders/<order_id>/cancel"
    },
    {
      "handler": "reject_order_route",
      "method": "POST",
      "module": "app/routes.py",
      "path": "/orders/<order_id>/reject"
    },
    {
      "handler": "list_trader_positions_route",
      "method": "GET",
      "module": "app/routes.py",
      "path": "/traders/<trader_id>/positions"
    },
    {
      "handler": "trader_risk_summary_route",
      "method": "GET",
      "module": "app/routes.py",
      "path": "/traders/<trader_id>/risk-summary"
    }
  ],
  "scheduled_jobs": [
    {
      "body": {
        "ensures": [
          {
            "args": {
              "desk": "desk",
              "report_date": "now"
            },
            "kind": "invoke",
            "trigger": "submit_position_report"
          }
        ],
        "post_invocations": [],
        "requires": [],
        "when": "desk: TradingDesk.status = active"
      },
      "guidance": "Runs daily at 18:00 UTC. Builds one position report per desk with non-empty open-position entries and submits it to the regulator integration; receipt_ids are collected per desk.",
      "name": "daily_regulator_report"
    },
    {
      "body": {
        "ensures": [],
        "post_invocations": [],
        "requires": [],
        "when": "position: Position.status = open"
      },
      "guidance": "Runs daily at 17:00 UTC. Re-marks every open position against the latest last-price snapshot for its instrument. In this fixture the MTM is computed on read, so the job is a no-op trigger.",
      "name": "end_of_day_mark_to_market"
    },
    {
      "body": {
        "ensures": [
          {
            "args": {
              "trader": "trader"
            },
            "kind": "invoke",
            "trigger": "evaluate_limit_breach"
          }
        ],
        "post_invocations": [],
        "requires": [],
        "when": "trader: Trader.status = active"
      },
      "guidance": "Runs every config.risk_agg_window during trading hours (07:00-17:30 UTC). Iterates every active trader and invokes evaluate_limit_breach.",
      "name": "intraday_risk_aggregator"
    },
    {
      "body": {
        "ensures": [
          {
            "args": {
              "call": "call"
            },
            "kind": "invoke",
            "trigger": "default_margin_call"
          }
        ],
        "post_invocations": [],
        "requires": [
          "call.status = issued"
        ],
        "when": "call: MarginCall.deadline <= now"
      },
      "guidance": "Hourly sweep. Any margin call still in issued state past its deadline is transitioned to defaulted.",
      "name": "margin_call_deadline_check"
    },
    {
      "body": {
        "ensures": [
          {
            "args": {
              "position": "position"
            },
            "kind": "invoke",
            "trigger": "close_flat_position"
          }
        ],
        "post_invocations": [],
        "requires": [
          "position.status = flat"
        ],
        "when": "position: Position.last_activity_at + config.stale_flat_after <= now"
      },
      "guidance": "Daily sweep. Flat positions that have been inactive for config.stale_flat_after transition to closed.",
      "name": "stale_position_closer"
    }
  ],
  "transitions": [
    {
      "body": {
        "ensures": [
          {
            "kind": "assign",
            "lhs": "order.quantity_filled",
            "rhs": "order.quantity_filled + fill_quantity"
          },
          {
            "kind": "assign",
            "lhs": "order.last_activity_at",
            "rhs": "now"
          },
          {
            "kind": "assign",
            "lhs": "order.trader.last_activity_at",
            "rhs": "now"
          },
          {
            "args": {
              "fill_price_pence": "fill_price_pence",
              "fill_quantity": "fill_quantity",
              "instrument": "order.instrument",
              "side": "order.side",
              "trader": "order.trader"
            },
            "kind": "invoke",
            "trigger": "apply_fill_to_position"
          },
          {
            "args": {
              "trader": "order.trader"
            },
            "kind": "invoke",
            "trigger": "evaluate_limit_breach"
          }
        ],
        "lets": [],
        "params": [
          {
            "name": "fill_price_pence",
            "type_hint": "Integer"
          },
          {
            "name": "fill_quantity",
            "type_hint": "Integer"
          },
          {
            "name": "order",
            "type_hint": "Order"
          },
          {
            "name": "trader",
            "type_hint": "Trader"
          }
        ],
        "requires": [
          "fill_quantity <= order.remaining_quantity",
          "fill_quantity > 0",
          "order.status in {pending, partially_filled}",
          "trader.status = active"
        ]
      },
      "called_from": [
        "app/services/orders.py:apply_fill"
      ],
      "entity": "Order",
      "guidance": "Status becomes filled when remaining_quantity reaches zero, otherwise partially_filled. Re-evaluates the trader's risk limits after every fill.",
      "name": "apply_fill"
    },
    {
      "body": {
        "ensures": [
          {
            "kind": "assign",
            "lhs": "order.status",
            "rhs": "cancelled"
          },
          {
            "kind": "assign",
            "lhs": "order.last_activity_at",
            "rhs": "now"
          }
        ],
        "lets": [],
        "params": [
          {
            "name": "order",
            "type_hint": "Order"
          }
        ],
        "requires": [
          "order.status in {pending, partially_filled}"
        ]
      },
      "called_from": [
        "app/routes.py:cancel_order_route"
      ],
      "entity": "Order",
      "guidance": "Cancellation is permitted only while the order is still pending or partially_filled",
      "name": "cancel_order"
    },
    {
      "body": {
        "ensures": [
          {
            "kind": "assign",
            "lhs": "call.status",
            "rhs": "cleared"
          },
          {
            "kind": "assign",
            "lhs": "call.cleared_at",
            "rhs": "now"
          }
        ],
        "lets": [],
        "params": [
          {
            "name": "call",
            "type_hint": "MarginCall"
          }
        ],
        "requires": [
          "call.status = posted"
        ]
      },
      "called_from": [
        "app/routes.py:clear_margin_route"
      ],
      "entity": "MarginCall",
